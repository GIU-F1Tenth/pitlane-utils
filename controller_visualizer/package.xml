<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeid="package_format3"?>
<package format="3">
    <name>controller_visualizer</name>
    <version>2.0.0</version>
    <description>Universal F1TENTH Controller Visualizer - Real-time visualization tool for LQR,
        LQG, MPC, and other F1TENTH controllers</description>

    <maintainer email="mohammed@azab.io">Mohammed Azab</maintainer>

    <license>MIT</license>

    <url type="website">https://github.com/f1tenth/race_stack</url>
    <url type="bugtracker">https://github.com/f1tenth/race_stack/issues</url>
    <url type="repository">https://github.com/f1tenth/race_stack</url>

    <buildtool_depend>ament_python</buildtool_depend>

    <!-- ROS2 dependencies -->
    <depend>rclpy</depend>
    <depend>std_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>ackermann_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>diagnostic_msgs</depend>
    <depend>tf2_ros</depend>
    <depend>tf2_geometry_msgs</depend>

    <!-- Python dependencies -->
    <exec_depend>python3-numpy</exec_depend>
    <exec_depend>python3-matplotlib</exec_depend>
    <exec_depend>python3-yaml</exec_depend>
    <exec_depend>python3-tk</exec_depend>

    <!-- Optional custom interfaces -->
    <depend condition="$ROS_DISTRO == humble">giu_f1t_interfaces</depend>

    <!-- Testing -->
    <test_depend>ament_flake8</test_depend>
    <test_depend>ament_pep257</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>

</package>