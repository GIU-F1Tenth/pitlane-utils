{
    "controller_type": "lqr",
    "max_history": 1000,
    "update_rate_hz": 10,
    "topics": {
        "control_output": "/drive",
        "odometry": "/odom",
        "trajectory": "/horizon_mapper/reference_trajectory",
        "diagnostics": "/diagnostics",
        "state_error": "/state_error",
        "path_ready": "/horizon_mapper/path_ready",
        "emergency_stop": "/emergency_stop",
        "controller_status": "/controller_status"
    },
    "visualization": {
        "show_trajectory": true,
        "show_control_history": true,
        "show_performance": true,
        "show_diagnostics": true
    },
    "plots": {
        "trajectory": {
            "vehicle_color": "red",
            "reference_color": "blue",
            "vehicle_size": 8,
            "arrow_length": 0.5
        },
        "control": {
            "acceleration_color": "blue",
            "steering_color": "red",
            "actual_color": "green"
        },
        "performance": {
            "error_color": "green",
            "velocity_color": "magenta",
            "reference_alpha": 0.7
        }
    },
    "export": {
        "default_format": "json",
        "include_config": true,
        "timestamp_format": "%Y%m%d_%H%M%S"
    },
    "controller_configs": {
        "lqr": {
            "topics": {
                "state_error": "/lqr/state_error",
                "diagnostics": "/lqr/diagnostics"
            }
        },
        "lqg": {
            "topics": {
                "state_error": "/lqg/state_error",
                "diagnostics": "/lqg/diagnostics",
                "estimation_error": "/lqg/estimation_error"
            }
        },
        "mpc": {
            "topics": {
                "predicted_trajectory": "/mpc/predicted_trajectory",
                "optimization_time": "/mpc/optimization_time",
                "diagnostics": "/mpc/diagnostics"
            }
        }
    }
}